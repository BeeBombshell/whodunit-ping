{
  "name": "whodunit-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Somebody pinged you. Nobody knows who. A tiny, portable, privacy-first anonymous ping engine.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/**\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "dev:node": "pnpm --filter @whodunit/adapter-node run dev",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@whodunit/adapter-vercel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "keywords": [
    "anonymous",
    "ping",
    "notifications",
    "ntfy",
    "pushover",
    "telegram",
    "discord",
    "privacy"
  ],
  "author": "Whodunit Contributors",
  "license": "MIT"
}
