# ==========================================
# Whodunit Configuration
# "Somebody pinged you. Nobody knows who."
# ==========================================

# Active provider(s) (comma-separated for multi-dispatch: ntfy,pushover,telegram,discord)
PROVIDER=ntfy

# --- ntfy settings ---
NTFY_TOPIC=my-whodunit-private-topic
NTFY_SERVER=https://ntfy.sh

# --- Pushover settings ---
# PUSHOVER_TOKEN=your_pushover_app_token
# PUSHOVER_USER=your_pushover_user_key

# --- Telegram settings ---
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=987654321

# --- Discord settings ---
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- CORS & Security ---
# Comma-separated list of allowed origins. Highly recommended in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Notification title prefix (default: "Whodunit")
TITLE_PREFIX=Whodunit Ping

# Character length limit for incoming message (default: 500)
MAX_LENGTH=500

# Rate limiting (requests per window)
RATE_LIMIT=5
RATE_LIMIT_WINDOW_SEC=3600

# Global daily capacity limit (optional protection against notification flood)
# DAILY_CAP=50

# Bot verification: none | turnstile
BOT_CHECK=none
# TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Emergency kill-switch: set to true to immediately reject incoming requests with 503
DISABLED=false

# Port for Node / Docker server adapter
PORT=3000
