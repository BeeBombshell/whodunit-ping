{
  "name": "@whodunit/providers",
  "version": "0.1.0",
  "description": "Notification providers for Whodunit: ntfy, Pushover, Telegram, Discord, and email",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @whodunit/providers^... build",
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@whodunit/core": "workspace:*"
  },
  "keywords": ["whodunit", "providers", "ntfy", "pushover", "telegram", "discord"],
  "author": "Whodunit Contributors",
  "license": "MIT"
}
