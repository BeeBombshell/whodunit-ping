{
  "name": "@whodunit/adapter-vercel",
  "version": "0.1.0",
  "description": "Vercel Edge / Serverless function adapter for Whodunit",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "pnpm --filter @whodunit/adapter-vercel^... build",
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run"
  },
  "dependencies": {
    "@whodunit/core": "workspace:*",
    "@whodunit/providers": "workspace:*"
  },
  "keywords": ["whodunit", "adapter", "vercel", "edge"],
  "author": "Whodunit Contributors",
  "license": "MIT"
}
