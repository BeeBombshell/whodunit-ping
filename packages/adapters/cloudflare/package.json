{
  "name": "@whodunit/adapter-cloudflare",
  "version": "0.1.0",
  "description": "Cloudflare Workers adapter for Whodunit",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @whodunit/adapter-cloudflare^... build",
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run"
  },
  "dependencies": {
    "@whodunit/core": "workspace:*",
    "@whodunit/providers": "workspace:*"
  },
  "keywords": ["whodunit", "adapter", "cloudflare", "workers"],
  "author": "Whodunit Contributors",
  "license": "MIT"
}
